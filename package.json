{
  "name": "ollie-cisa-coach-host",
  "version": "1.0.0",
  "description": "Ollie CISA Coach: a free CISA exam study app, self-hostable or deployable to Vercel with Google sign-in, synced progress, a study-buddy leaderboard and an optional AI tutor",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node scripts/test.js && node scripts/test-ai.js",
    "backup": "node scripts/backup.js",
    "import-app": "node scripts/import-app.js",
    "build:pages": "node scripts/build-pages.js",
    "dev": "DEV_FAKE_AUTH=1 node server/index.js",
    "build:vercel": "node scripts/build-vercel.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@libsql/client": "^0.18.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
