# Copy to .env and fill in. Never commit .env.

# Public address people will type, no trailing slash. Must be https:// in production.
BASE_URL=https://coach.example.com
PORT=3000
NODE_ENV=production

# From Google Cloud Console > Credentials > OAuth client ID (type: Web application).
# See docs/GOOGLE_SETUP.md. Only the client ID is needed (no client secret) for this sign-in flow.
GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Random string, 32+ characters. Generate one:  openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=

# Comma-separated Google emails that may open /admin.html
ADMIN_EMAILS=you@gmail.com

# Days a sign-in lasts before asking again
SESSION_DAYS=30

# Optional: only allow these email domains to sign in (blank = any Google account)
ALLOWED_EMAIL_DOMAINS=

# Shown in the footer, privacy notice and terms
SITE_NAME=Ollie CISA Coach
OPERATOR_NAME=Your Name or Company
CONTACT_EMAIL=you@example.com

# Where the SQLite file lives (the Docker setup mounts ./data here)
DATA_DIR=./data

# Optional privacy-friendly analytics, loaded only after a visitor clicks "Allow".
# Plausible example. Leave blank to disable.
ANALYTICS_SRC=
ANALYTICS_DOMAIN=

# Number of reverse proxies in front of the app (Caddy/nginx = 1). Needed for correct rate limiting by IP.
TRUST_PROXY=1

# Optional "Ask Ollie" AI features (tutor chat, explain in another language, new practice questions).
# Off unless you set an Anthropic API key from https://console.anthropic.com. See docs/AI_SETUP.md.
# The key stays on your server and is never sent to browsers. You pay Anthropic for usage.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high (blank = model default). low keeps answers quick and cheap.
AI_EFFORT=low
AI_MAX_TOKENS=2000
# Spending guards: AI needs sign-in (recommended), per-minute and daily caps
AI_REQUIRE_SIGNIN=true
AI_PER_MINUTE=10
AI_DAILY_PER_USER=40
AI_DAILY_SITE=1000
